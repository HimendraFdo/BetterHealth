# Copy to .env and adjust. .env is gitignored; this file documents the keys.
PORT=3000
HOST=127.0.0.1

# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# The client ID is not secret, but the client secret is: keep it only in .env.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback

# PostgreSQL connection (matches docker-compose.yml). Format:
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://betterhealth:change-me@127.0.0.1:5432/betterhealth

# Background sync of steps and calories from Google into PostgreSQL.
# How often to sync, in minutes. 0 turns the scheduled sync off
# (POST /api/sync still works).
SYNC_INTERVAL_MINUTES=60
# How many days of history the first sync downloads.
SYNC_BACKFILL_DAYS=365

# "Today" is worked out in the server's time zone. Set this on a server that
# runs in UTC so days start at your midnight, e.g. TZ=Europe/London.
# TZ=Europe/London
